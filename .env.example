# 总控台环境变量。复制成 .env 不生效——本项目直接读进程环境变量，
# 用 set / export 设置，或者写在启动脚本里。

# ---- 必填：模型密钥（有任一即可，按下面的优先级取）----
# ORCH_API_KEY=sk-xxx
DEEPSEEK_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# MOONSHOT_API_KEY=

# ---- 接口地址（默认 DeepSeek，换别家只改这里）----
# ORCH_BASE_URL=https://api.deepseek.com
# 千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱：https://open.bigmodel.cn/api/paas/v4
# Kimi：https://api.moonshot.cn/v1

# ---- 模型选择 ----
# 规划用快的：实测结构化输出质量与强模型相当，耗时少一半
# ORCH_MODEL_PLANNER=deepseek-flash
# 执行用两档：fast 角色用快模型，strong 角色用强模型
# ORCH_MODEL_FAST=deepseek-flash
# ORCH_MODEL_STRONG=deepseek-v4-pro
# 汇总默认也用快的，想要更强综合能力就换 pro
# ORCH_MODEL_SUMMARY=deepseek-flash

# 思考开销：low 省时间，high 更稳（规划默认 low）
# ORCH_PLAN_EFFORT=low
# ORCH_SUMMARY_EFFORT=high

# ---- 运行参数 ----
# PORT=5180
# HOST=127.0.0.1
# 同一层最多几个智能体同时跑
# ORCH_CONCURRENCY=3
# 单次请求超时（毫秒）
# ORCH_TIMEOUT=300000

# ---- 开发智能体 ----
# 写代码比写文档难，默认用强模型；嫌慢可换 deepseek-flash（质量会降）
# ORCH_MODEL_DEV=deepseek-v4-pro
# 出实施方案用快的，实测质量够用
# ORCH_MODEL_DEV_PLAN=deepseek-flash
# 工具循环最大步数（默认 40）
# ORCH_DEV_MAX_STEPS=40
# 单条命令超时，毫秒（默认 300000 = 5 分钟）
# ORCH_DEV_CMD_TIMEOUT=300000
# 单次工具循环的 token 总预算（默认 600000），超了强制收尾
# ORCH_DEV_MAX_TOKENS=600000
# 工作区选择器的起始目录（默认用户主目录）
# ORCH_DEV_ROOT=C:/Users/your-name

# ---- 架构智能体 ----
# 架构判断要权衡真实的取舍，默认用强模型；换成 fast 会明显更容易给出"正确的废话"
# ORCH_MODEL_ARCH=deepseek-v4-pro
# 诊断阶段最多读几个样本文件（默认 14，范围 4~30）。读多了很贵，读少了看不准
# ORCH_ARCH_SAMPLE=14
# 写文档阶段最大工具循环步数（默认 24，范围 6~60）
# ORCH_ARCH_MAX_STEPS=24
# 单次写文档的 token 总预算（默认 600000）
# ORCH_ARCH_MAX_TOKENS=600000
